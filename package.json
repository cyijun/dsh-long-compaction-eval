{
  "name": "dsh-long-compaction-eval",
  "version": "0.1.0",
  "description": "Reproducible long-task evaluation for DeepSeek Harness compaction providers",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "dsh-long-compaction-eval": "dist/cli.js"
  },
  "files": [
    "dist",
    "harbor",
    "examples",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test && npm run lint && npm run build",
    "lint": "oxlint src tests",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.4",
    "@deepseek-ai/dsh-acp-demo": "0.1.1-rc.2",
